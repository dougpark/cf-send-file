{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "types": ["bun", "@cloudflare/workers-types"]
  },
  "include": [
    "src/index.ts",
    "src/db/**/*.ts",
    "src/middleware/**/*.ts",
    "src/routes/**/*.ts",
    "src/lib/auth.ts",
    "src/lib/auth.test.ts",
    "src/lib/auth-security.test.ts",
    "src/lib/config.ts",
    "src/lib/context.ts",
    "src/lib/email.ts",
    "src/lib/settings.ts",
    "src/lib/help-rag.ts",
    "src/lib/help-rag.test.ts",
    "src/lib/help-chat-route.test.ts",
    "src/routes/**/*.test.ts",
    "src/test/**/*.ts",
    "scripts/**/*.ts",
    "drizzle.config.ts"
  ]
}
